  rules_version = '2';
  
  // All reads and writes go through the school library API (/api/rpc), which runs
  // with the Firebase Admin SDK, checks the signed-in account, its role and its
  // status, and records an audit log. Browsers must never read or write Firestore
  // directly, so every client request is denied here.
  service cloud.firestore {
    match /databases/{database}/documents {
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
